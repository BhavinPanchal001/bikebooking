# Razorpay + bootstrap credentials for Cloud Functions.
#
# Copy this file to `.env.<your-firebase-project-id>` (e.g. `.env.bikenest-app`)
# on the machine that runs `firebase deploy`. Firebase Functions v2 loads it
# automatically into `process.env` when deploying to that project.
#
# The real file (`.env*`) is gitignored — do NOT commit filled values.
#
# Rotate these values via the Razorpay dashboard if they ever leak:
#   https://dashboard.razorpay.com/app/keys
#   https://dashboard.razorpay.com/app/webhooks

# Razorpay API keys (Test or Live). Pair must match — mixing test key id
# with live secret will 401 every request.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Pick any long random string here AND paste the same value into the
# "Secret" field when you register the webhook in the Razorpay dashboard.
# Webhook deliveries are HMAC-signed with this secret.
RAZORPAY_WEBHOOK_SECRET=replace_me_with_a_long_random_string

# Email of the first admin — the `setAdminClaim` callable refuses to mint
# admin claims unless the caller's Firebase Auth email matches this.
# Rotate / clear after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
